{
  "info": {
    "name": "TenantPlus Rent Payments API",
    "description": "Postman collection for manual rent payments and eSewa payment flow in TenantPlus.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "agreement_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "rent_payment_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "esewa_data",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "List Rent Payments",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/rent-payments/?agreement_id={{agreement_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "rent-payments"
          ],
          "query": [
            {
              "key": "agreement_id",
              "value": "{{agreement_id}}",
              "disabled": true
            }
          ]
        },
        "description": "List rent payments for the authenticated tenant or landlord. Optionally filter by agreement_id."
      }
    },
    {
      "name": "Create Manual Rent Payment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"agreement\": \"{{agreement_id}}\",\n  \"payment_month\": \"2026-07-01\",\n  \"amount\": \"15000.00\",\n  \"notes\": \"Paid in cash.\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/rent-payments/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "rent-payments"
          ]
        },
        "description": "Record a manual rent payment. Tenants only."
      }
    },
    {
      "name": "Get Rent Payment Detail",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/rent-payments/{{rent_payment_id}}/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "rent-payments",
            "{{rent_payment_id}}"
          ]
        },
        "description": "Retrieve a single rent payment record."
      }
    },
    {
      "name": "Rent Payment Summary",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/rent-payments/summary/?agreement_id={{agreement_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "rent-payments",
            "summary"
          ],
          "query": [
            {
              "key": "agreement_id",
              "value": "{{agreement_id}}"
            }
          ]
        },
        "description": "Get total paid, late fees, count, and latest payment info for a tenant agreement."
      }
    },
    {
      "name": "Initiate eSewa Payment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"agreement\": \"{{agreement_id}}\",\n  \"payment_month\": \"2026-07-01\",\n  \"amount\": \"15000.00\",\n  \"notes\": \"Initiate eSewa payment.\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/rent-payments/esewa/initiate/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "rent-payments",
            "esewa",
            "initiate"
          ]
        },
        "description": "Create an eSewa payment log and get form data for redirecting to eSewa."
      }
    },
    {
      "name": "Verify eSewa Payment",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/rent-payments/esewa/verify/?data={{esewa_data}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "rent-payments",
            "esewa",
            "verify"
          ],
          "query": [
            {
              "key": "data",
              "value": "{{esewa_data}}"
            }
          ]
        },
        "description": "Verify the callback payload returned by eSewa after payment completion."
      }
    }
  ]
}
